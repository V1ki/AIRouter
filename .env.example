# Database configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_router

# Optional: Initialize with common AI providers
# Set to "true" to automatically add OpenAI, Claude, Gemini, etc. during initialization
INIT_COMMON_PROVIDERS=true

# Optional: API Key for AI Router itself (if you want to protect the management API)
# AI_ROUTER_API_KEY=your-secret-key

# Optional: CORS settings (comma-separated list of allowed origins)
# CORS_ORIGINS=http://localhost:3000,https://yourdomain.com